{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm build)",
      "Bash(pnpm exec tsc *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(pnpm install *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm exec tsc *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git tag *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
